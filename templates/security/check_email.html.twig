{% trans_default_domain 'Te4gUserBundle' %}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>{{ 'check_email.title'|trans }}</title></head>
<body>
<main>
    <h1>{{ 'check_email.title'|trans }}</h1>
    <div aria-live="polite"><p>{{ 'check_email.status'|trans }}</p></div>
    {{ form_start(resend_form) }}
        {% if resend_form.vars.submitted and not resend_form.vars.valid %}
            <div role="alert"><p>{{ 'form.error_summary'|trans }}</p>{{ form_errors(resend_form) }}</div>
        {% endif %}
        <div>{{ form_label(resend_form.email) }}{{ form_widget(resend_form.email) }}{{ form_errors(resend_form.email) }}</div>
        {{ form_rest(resend_form) }}
        <button type="submit">{{ 'check_email.resend'|trans }}</button>
    {{ form_end(resend_form, {render_rest: false}) }}
</main>
</body>
</html>
