{% trans_default_domain 'Te4gUserBundle' %}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>{{ 'login_link.title'|trans }}</title></head>
<body>
<main>
    <h1>{{ 'login_link.title'|trans }}</h1>
    <div aria-live="polite">{{ 'login_link.status'|trans }}</div>
    <form method="post" action="{{ path('te4g_user_login_link_check') }}">
        {% for name, value in login_link_parameters %}
            <input type="hidden" name="{{ name }}" value="{{ value }}">
        {% endfor %}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('te4g_user_login_link_check') }}">
        <button type="submit">{{ 'login_link.submit'|trans }}</button>
    </form>
</main>
</body>
</html>
