{% trans_default_domain 'Te4gUserBundle' %}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>{{ 'password_change.title'|trans }}</title></head>
<body>
<main>
    <h1>{{ 'password_change.title'|trans }}</h1>
    <div aria-live="polite">
        {% if password_change_failed %}<p role="alert">{{ 'password_change.failed'|trans }}</p>{% endif %}
    </div>
    {{ form_start(form) }}
        {% if form.vars.submitted and not form.vars.valid %}
            <div role="alert"><p>{{ 'form.error_summary'|trans }}</p>{{ form_errors(form) }}</div>
        {% endif %}
        <div>{{ form_label(form.currentPassword) }}{{ form_widget(form.currentPassword) }}{{ form_errors(form.currentPassword) }}</div>
        <div>{{ form_label(form.plainPassword.first) }}{{ form_widget(form.plainPassword.first) }}{{ form_errors(form.plainPassword.first) }}</div>
        <div>{{ form_label(form.plainPassword.second) }}{{ form_widget(form.plainPassword.second) }}{{ form_errors(form.plainPassword) }}{{ form_errors(form.plainPassword.second) }}</div>
        {{ form_rest(form) }}
        <button type="submit">{{ 'password_change.submit'|trans }}</button>
    {{ form_end(form, {render_rest: false}) }}
</main>
</body>
</html>
