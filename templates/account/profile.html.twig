{% trans_default_domain 'Te4gUserBundle' %}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>{{ 'profile.title'|trans }}</title></head>
<body>
<main>
    <h1>{{ 'profile.title'|trans }}</h1>
    <div aria-live="polite">
        {% if email_change_failed %}<p role="alert">{{ 'profile.change_failed'|trans }}</p>{% endif %}
    </div>
    <p>{{ 'account.active_email'|trans }}: <span data-account-active-email>{{ account.email }}</span></p>
    {% if account.pendingEmail %}<p>{{ 'account.pending_email'|trans }}: <span data-account-pending-email>{{ account.pendingEmail }}</span></p>{% endif %}
    {{ form_start(form) }}
        {% if form.vars.submitted and not form.vars.valid %}
            <div role="alert"><p>{{ 'form.error_summary'|trans }}</p>{{ form_errors(form) }}</div>
        {% endif %}
        <div>{{ form_label(form.email) }}{{ form_widget(form.email) }}{{ form_errors(form.email) }}</div>
        <div>{{ form_label(form.currentPassword) }}{{ form_widget(form.currentPassword) }}{{ form_errors(form.currentPassword) }}</div>
        {{ form_rest(form) }}
        <button type="submit">{{ 'profile.submit'|trans }}</button>
    {{ form_end(form, {render_rest: false}) }}
</main>
</body>
</html>
