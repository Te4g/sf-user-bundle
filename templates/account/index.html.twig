{% trans_default_domain 'Te4gUserBundle' %}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>{{ 'account.title'|trans }}</title></head>
<body>
<main>
    <h1>{{ 'account.title'|trans }}</h1>
    <div aria-live="polite">
        {% if deletion_failed %}<p role="alert">{{ 'account.deletion_failed'|trans }}</p>{% endif %}
    </div>
    <dl>
        <dt>{{ 'account.active_email'|trans }}</dt>
        <dd data-account-active-email>{{ account.email }}</dd>
        {% if account.pendingEmail %}
            <dt>{{ 'account.pending_email'|trans }}</dt>
            <dd data-account-pending-email>{{ account.pendingEmail }}</dd>
        {% endif %}
    </dl>
    <nav aria-label="{{ 'account.navigation'|trans }}">
        <a href="{{ path('te4g_user_profile') }}">{{ 'account.profile_action'|trans }}</a>
        <a href="{{ path('te4g_user_password_change') }}">{{ 'account.password_action'|trans }}</a>
    </nav>
    {% if deletion_form %}
        <section aria-labelledby="delete-account-title">
            <h2 id="delete-account-title">{{ 'account.delete_title'|trans }}</h2>
            {{ form_start(deletion_form) }}
                {% if deletion_form.vars.submitted and not deletion_form.vars.valid %}
                    <div role="alert"><p>{{ 'form.error_summary'|trans }}</p>{{ form_errors(deletion_form) }}</div>
                {% endif %}
                <div>{{ form_label(deletion_form.currentPassword) }}{{ form_widget(deletion_form.currentPassword) }}{{ form_errors(deletion_form.currentPassword) }}</div>
                <div>{{ form_widget(deletion_form.confirm) }}{{ form_label(deletion_form.confirm) }}{{ form_errors(deletion_form.confirm) }}</div>
                {{ form_rest(deletion_form) }}
                <button type="submit">{{ 'account.delete_submit'|trans }}</button>
            {{ form_end(deletion_form, {render_rest: false}) }}
        </section>
    {% endif %}
</main>
</body>
</html>
