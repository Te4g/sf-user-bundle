{% extends 'bundles/Te4gUserBundle/layout.html.twig' %}
{% trans_default_domain 'Te4gUserBundle' %}
{% block title %}{{ 'profile.title'|trans }}{% endblock %}
{% block body %}
<main class="mx-auto w-full max-w-2xl px-4 py-12"><twig:Card>
<twig:Card:Header><twig:Card:Title><h1 class="text-xl">{{ 'profile.title'|trans }}</h1></twig:Card:Title><twig:Card:Description><span data-account-active-email>{{ account.email }}</span>{% if account.pendingEmail %} · <span data-account-pending-email>{{ account.pendingEmail }}</span>{% endif %}</twig:Card:Description></twig:Card:Header>
<twig:Card:Content><div aria-live="polite">{% if email_change_failed %}<twig:Alert variant="destructive"><twig:Alert:Title>{{ 'profile.change_failed'|trans }}</twig:Alert:Title></twig:Alert>{% endif %}</div>
{{ form_start(form, {attr: {class: 'space-y-5'}}) }}{% if form.vars.submitted and not form.vars.valid %}<twig:Alert variant="destructive"><twig:Alert:Title>{{ 'form.error_summary'|trans }}</twig:Alert:Title><twig:Alert:Description>{{ form_errors(form) }}</twig:Alert:Description></twig:Alert>{% endif %}
<twig:Field><twig:Field:Label for="{{ form.email.vars.id }}" class="{{ form.email.vars.required ? 'required' : '' }}">{{ form.email.vars.label|trans(form.email.vars.label_translation_parameters, form.email.vars.translation_domain) }}</twig:Field:Label>{{ form_widget(form.email, {attr: {'aria-describedby': 'profile_email_errors'}}) }}{{ form_errors(form.email) }}</twig:Field>
<twig:Field data-controller="password-visibility" data-password-visibility-show-label-value="{{ 'password.show'|trans }}" data-password-visibility-hide-label-value="{{ 'password.hide'|trans }}"><twig:Field:Label for="{{ form.currentPassword.vars.id }}" class="{{ form.currentPassword.vars.required ? 'required' : '' }}">{{ form.currentPassword.vars.label|trans(form.currentPassword.vars.label_translation_parameters, form.currentPassword.vars.translation_domain) }}</twig:Field:Label><div class="relative">{{ form_widget(form.currentPassword, {attr: {'aria-describedby': 'profile_currentPassword_errors', 'data-password-visibility-target': 'input', class: 'pr-28'}}) }}<twig:Button type="button" variant="ghost" size="sm" class="absolute right-1 top-1" aria-pressed="false" data-password-visibility-target="button" data-action="click->password-visibility#toggle"><twig:ux:icon name="lucide:eye" /><span data-password-visibility-target="label">{{ 'password.show'|trans }}</span></twig:Button></div>{{ form_errors(form.currentPassword) }}</twig:Field>
{{ form_rest(form) }}<twig:Button type="submit" data-turbo-submits-with="{{ 'form.submitting'|trans }}">{{ 'profile.submit'|trans }}</twig:Button>{{ form_end(form, {render_rest: false}) }}
</twig:Card:Content></twig:Card></main>
{% endblock %}
