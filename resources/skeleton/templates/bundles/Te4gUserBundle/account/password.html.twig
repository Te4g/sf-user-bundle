{% trans_default_domain 'Te4gUserBundle' %}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ 'password_change.title'|trans }}</title></head>
<body class="min-h-screen bg-background text-foreground"><main class="mx-auto w-full max-w-2xl px-4 py-12"><twig:Card>
<twig:Card:Header><twig:Card:Title><h1 class="flex items-center gap-2 text-xl"><twig:ux:icon name="lucide:eye-off" />{{ 'password_change.title'|trans }}</h1></twig:Card:Title></twig:Card:Header><twig:Card:Content><div aria-live="polite">{% if password_change_failed %}<twig:Alert variant="destructive"><twig:Alert:Title>{{ 'password_change.failed'|trans }}</twig:Alert:Title></twig:Alert>{% endif %}</div>
{{ form_start(form, {attr: {class: 'space-y-5'}}) }}{% if form.vars.submitted and not form.vars.valid %}<twig:Alert variant="destructive"><twig:Alert:Title>{{ 'form.error_summary'|trans }}</twig:Alert:Title><twig:Alert:Description>{{ form_errors(form) }}</twig:Alert:Description></twig:Alert>{% endif %}
<twig:Field><twig:Field:Label>{{ form_label(form.currentPassword) }}</twig:Field:Label>{{ form_widget(form.currentPassword, {attr: {'aria-describedby': 'password_change_currentPassword_errors'}}) }}{{ form_errors(form.currentPassword) }}</twig:Field>
<twig:Field data-controller="password-visibility" data-password-visibility-show-label-value="{{ 'password.show'|trans }}" data-password-visibility-hide-label-value="{{ 'password.hide'|trans }}"><twig:Field:Label>{{ form_label(form.plainPassword.first) }}</twig:Field:Label><div class="relative">{{ form_widget(form.plainPassword.first, {attr: {'aria-describedby': 'password_change_plainPassword_first_errors', 'data-password-visibility-target': 'input', class: 'pr-28'}}) }}<twig:Button type="button" variant="ghost" size="sm" class="absolute right-1 top-1" aria-pressed="false" data-password-visibility-target="button" data-action="click->password-visibility#toggle"><twig:ux:icon name="lucide:eye" /><span data-password-visibility-target="label">{{ 'password.show'|trans }}</span></twig:Button></div>{{ form_errors(form.plainPassword.first) }}</twig:Field>
<twig:Field><twig:Field:Label>{{ form_label(form.plainPassword.second) }}</twig:Field:Label>{{ form_widget(form.plainPassword.second, {attr: {'aria-describedby': 'password_change_plainPassword_errors password_change_plainPassword_second_errors'}}) }}{{ form_errors(form.plainPassword) }}{{ form_errors(form.plainPassword.second) }}</twig:Field>
{{ form_rest(form) }}<twig:Button type="submit" data-turbo-submits-with="{{ 'form.submitting'|trans }}"><twig:Spinner class="hidden" label="{{ 'form.submitting'|trans }}" />{{ 'password_change.submit'|trans }}</twig:Button>{{ form_end(form, {render_rest: false}) }}
</twig:Card:Content></twig:Card></main></body></html>
