{% extends 'bundles/Te4gUserBundle/layout.html.twig' %}
{% trans_default_domain 'Te4gUserBundle' %}
{% block title %}{{ 'account.title'|trans }}{% endblock %}
{% block body %}
<main class="mx-auto w-full max-w-2xl space-y-8 px-4 py-12">
    <header class="space-y-1"><h1 class="text-2xl font-semibold tracking-tight">{{ 'account.title'|trans }}</h1><p class="text-sm text-muted-foreground">{{ 'account.navigation'|trans }}</p></header>
    <div aria-live="polite">{% if deletion_failed %}<twig:Alert variant="destructive"><twig:ux:icon name="lucide:triangle-alert" /><twig:Alert:Title>{{ 'account.deletion_failed'|trans }}</twig:Alert:Title></twig:Alert>{% endif %}</div>

    <section aria-labelledby="account-email-heading" class="space-y-4">
        <h2 id="account-email-heading" class="text-base font-medium">{{ 'account.active_email'|trans }}</h2>
        <dl class="divide-y divide-border border-y border-border text-sm">
            <div class="grid gap-1 py-4 sm:grid-cols-[12rem_1fr]"><dt class="text-muted-foreground">{{ 'account.active_email'|trans }}</dt><dd data-account-active-email>{{ account.email }}</dd></div>
            {% if account.pendingEmail %}<div class="grid gap-1 py-4 sm:grid-cols-[12rem_1fr]"><dt class="text-muted-foreground">{{ 'account.pending_email'|trans }}</dt><dd data-account-pending-email>{{ account.pendingEmail }}</dd></div>{% endif %}
        </dl>
        <nav aria-label="{{ 'account.navigation'|trans }}" class="flex flex-wrap gap-2"><twig:Button as="a" href="{{ path('te4g_user_profile') }}" variant="outline">{{ 'account.profile_action'|trans }}</twig:Button><twig:Button as="a" href="{{ path('te4g_user_password_change') }}" variant="outline"><twig:ux:icon name="lucide:key-round" />{{ 'account.password_action'|trans }}</twig:Button></nav>
    </section>

    {% if deletion_form %}
        <twig:Separator />
        <section aria-labelledby="delete-account-title" class="space-y-4">
            <div><h2 id="delete-account-title" class="text-base font-medium text-destructive">{{ 'account.delete_title'|trans }}</h2><p class="mt-1 text-sm text-muted-foreground">{{ 'account.delete_copy'|trans }}</p></div>
            <twig:AlertDialog id="delete-account">
                {{ form_start(deletion_form, {attr: {class: 'space-y-4', 'data-alert-dialog-target': 'form'}}) }}
                    {% if deletion_form.vars.submitted and not deletion_form.vars.valid %}<twig:Alert variant="destructive"><twig:Alert:Title>{{ 'form.error_summary'|trans }}</twig:Alert:Title><twig:Alert:Description>{{ form_errors(deletion_form) }}</twig:Alert:Description></twig:Alert>{% endif %}
                    <twig:Field data-controller="password-visibility" data-password-visibility-show-label-value="{{ 'password.show'|trans }}" data-password-visibility-hide-label-value="{{ 'password.hide'|trans }}"><twig:Field:Label for="{{ deletion_form.currentPassword.vars.id }}" class="{{ deletion_form.currentPassword.vars.required ? 'required' : '' }}">{{ deletion_form.currentPassword.vars.label|trans(deletion_form.currentPassword.vars.label_translation_parameters, deletion_form.currentPassword.vars.translation_domain) }}</twig:Field:Label><div class="relative">{{ form_widget(deletion_form.currentPassword, {attr: {'aria-describedby': 'delete_account_currentPassword_errors', 'data-password-visibility-target': 'input', class: 'pr-28'}}) }}<twig:Button type="button" variant="ghost" size="sm" class="absolute right-1 top-1" aria-pressed="false" data-password-visibility-target="button" data-action="click->password-visibility#toggle"><twig:ux:icon name="lucide:eye" /><span data-password-visibility-target="label">{{ 'password.show'|trans }}</span></twig:Button></div>{{ form_errors(deletion_form.currentPassword) }}</twig:Field>
                    <twig:Field orientation="horizontal"><div>{{ form_widget(deletion_form.confirm, {attr: {'aria-describedby': 'delete_account_confirm_errors'}}) }}</div><twig:Field:Content><twig:Field:Label for="{{ deletion_form.confirm.vars.id }}" class="{{ deletion_form.confirm.vars.required ? 'required' : '' }}">{{ deletion_form.confirm.vars.label|trans(deletion_form.confirm.vars.label_translation_parameters, deletion_form.confirm.vars.translation_domain) }}</twig:Field:Label>{{ form_errors(deletion_form.confirm) }}</twig:Field:Content></twig:Field>
                    {{ form_widget(deletion_form._token) }}
                    <twig:AlertDialog:Trigger><twig:Button type="button" variant="destructive" {{ ...alert_dialog_trigger_attrs }}><twig:ux:icon name="lucide:trash-2" />{{ 'account.delete_submit'|trans }}</twig:Button></twig:AlertDialog:Trigger>
                    <twig:AlertDialog:Content>
                        <twig:AlertDialog:Header><twig:AlertDialog:Media class="bg-destructive/10 text-destructive"><twig:ux:icon name="lucide:triangle-alert" /></twig:AlertDialog:Media><twig:AlertDialog:Title>{{ 'account.delete_confirm_title'|trans }}</twig:AlertDialog:Title><twig:AlertDialog:Description>{{ 'account.delete_confirm_copy'|trans }}</twig:AlertDialog:Description></twig:AlertDialog:Header>
                        <twig:AlertDialog:Footer><twig:AlertDialog:Cancel type="button">{{ 'account.delete_cancel'|trans }}</twig:AlertDialog:Cancel><twig:AlertDialog:Action type="button" variant="destructive" data-action="click->alert-dialog#submit">{{ 'account.delete_submit'|trans }}</twig:AlertDialog:Action></twig:AlertDialog:Footer>
                    </twig:AlertDialog:Content>
                {{ form_end(deletion_form, {render_rest: false}) }}
            </twig:AlertDialog>
        </section>
    {% endif %}
</main>
{% endblock %}
