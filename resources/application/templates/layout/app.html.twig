{% extends 'base.html.twig' %}

{% block body %}
    <header class="border-b border-border/80 bg-background/95">
        <div class="mx-auto flex min-h-16 w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
            <a href="{{ path('app_dashboard') }}" class="rounded-md text-base font-semibold tracking-tight outline-none focus-visible:ring-3 focus-visible:ring-ring/50">{{ app_name }}</a>
            <nav aria-label="{{ 'navigation.account'|trans }}" class="flex flex-wrap items-center gap-1 text-sm">
                <twig:LanguageSwitcher />
                <a href="{{ path('app_dashboard') }}" class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">{{ 'navigation.dashboard'|trans }}</a>
                <a href="{{ path('app_account') }}" class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">{{ 'navigation.account_settings'|trans }}</a>
                <form method="post" action="{{ path('app_logout') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <twig:Button type="submit" variant="ghost">{{ 'navigation.sign_out'|trans }}</twig:Button>
                </form>
            </nav>
        </div>
    </header>
    {% block main %}{% endblock %}
{% endblock %}
