{% extends 'base.html.twig' %}

{% block body %}
    <header class="border-b border-border/80 bg-background/95">
        <div class="mx-auto flex min-h-16 w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
            <a href="{{ path('app_home') }}" class="rounded-md text-base font-semibold tracking-tight outline-none focus-visible:ring-3 focus-visible:ring-ring/50">Application</a>
            <nav aria-label="Primary navigation" class="flex items-center gap-2 text-sm">
                {% if app.user %}
                    <a href="{{ path('app_dashboard') }}" class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">Dashboard</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">Sign in</a>
                    <twig:Button as="a" href="{{ path('app_register') }}">Create account</twig:Button>
                {% endif %}
            </nav>
        </div>
    </header>
    {% block main %}{% endblock %}
{% endblock %}
