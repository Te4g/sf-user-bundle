{% macro icon(theme) %}
    {% if theme == 'system' %}
        <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="13" rx="2" />
            <path d="M8 21h8M12 17v4" />
        </svg>
    {% elseif theme == 'light' %}
        <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" />
        </svg>
    {% else %}
        <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" />
        </svg>
    {% endif %}
{% endmacro %}

{% import _self as icons %}
{% set themes = {system: 'System', light: 'Light', dark: 'Dark'} %}

<div class="group/theme relative inline-flex shrink-0" data-theme-switcher data-open="false">
    <button
        type="button"
        class="grid size-9 place-items-center rounded-full text-muted-foreground outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/50"
        data-theme-trigger
        aria-label="Theme: System"
        aria-expanded="false"
    >
        {% for theme, label in themes %}
            <span class="grid place-items-center" data-theme-current-icon="{{ theme }}"{% if theme != 'system' %} hidden{% endif %}>{{ icons.icon(theme) }}</span>
        {% endfor %}
    </button>

    <div class="invisible pointer-events-none absolute right-0 top-full z-50 translate-y-1 pt-2 opacity-0 transition-[opacity,transform,visibility] duration-150 ease-out motion-reduce:transition-none group-data-[open=true]/theme:visible group-data-[open=true]/theme:pointer-events-auto group-data-[open=true]/theme:translate-y-0 group-data-[open=true]/theme:opacity-100">
        <div class="flex flex-col gap-1 rounded-full border border-border bg-popover p-1 text-popover-foreground shadow-md" role="group" aria-label="Choose theme">
            {% for theme, label in themes %}
                <button
                    type="button"
                    class="grid size-9 place-items-center rounded-full text-muted-foreground outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:bg-muted focus-visible:text-foreground focus-visible:ring-2 focus-visible:ring-ring/50"
                    data-theme-option="{{ theme }}"
                    aria-label="{{ label }} theme"
                    title="{{ label }}"
                    {% if theme == 'system' %}hidden{% endif %}
                >
                    {{ icons.icon(theme) }}
                </button>
            {% endfor %}
        </div>
    </div>
</div>
