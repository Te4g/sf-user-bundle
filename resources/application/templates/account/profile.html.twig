{% extends 'layout/app.html.twig' %}

{% block title %}Profile · Application{% endblock %}

{% block main %}
<main class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
<div class="max-w-2xl">
    <twig:Card>
        <twig:Card:Header>
            <twig:Card:Title><h1 class="text-xl">Profile</h1></twig:Card:Title>
            <twig:Card:Description>Update your name or request a change to {{ account.email }}.</twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Content>
            {{ form_start(form, {attr: {class: 'space-y-5'}}) }}
                {% if form.vars.submitted and not form.vars.valid %}
                    <twig:Alert variant="destructive">
                        <twig:Alert:Title>{{ 'form.error_summary'|trans }}</twig:Alert:Title>
                        <twig:Alert:Description>{{ form_errors(form) }}</twig:Alert:Description>
                    </twig:Alert>
                {% endif %}
                <twig:Field>
                    <twig:Field:Label for="{{ form.name.vars.id }}" class="{{ form.name.vars.required ? 'required' : '' }}">{{ form.name.vars.label|trans(form.name.vars.label_translation_parameters, form.name.vars.translation_domain) }}</twig:Field:Label>
                    {{ form_widget(form.name, {attr: {'aria-describedby': form.name.vars.id ~ '_errors'}}) }}
                    {{ form_errors(form.name) }}
                </twig:Field>
                <twig:Field>
                    <twig:Field:Label for="{{ form.email.vars.id }}" class="{{ form.email.vars.required ? 'required' : '' }}">{{ form.email.vars.label|trans(form.email.vars.label_translation_parameters, form.email.vars.translation_domain) }}</twig:Field:Label>
                    {{ form_widget(form.email, {attr: {'aria-describedby': 'profile-email-help ' ~ form.email.vars.id ~ '_errors'}}) }}
                    <twig:Field:Description id="profile-email-help">A confirmation link is sent before your email address changes.</twig:Field:Description>
                    {{ form_errors(form.email) }}
                </twig:Field>
                {{ form_rest(form) }}
                <div class="flex flex-wrap gap-3">
                    <twig:Button type="submit" data-turbo-submits-with="{{ 'form.submitting'|trans }}">Save profile</twig:Button>
                    <twig:Button as="a" href="{{ path('app_account') }}" variant="ghost">Cancel</twig:Button>
                </div>
            {{ form_end(form, {render_rest: false}) }}
        </twig:Card:Content>
    </twig:Card>
</div>
</main>
{% endblock %}
