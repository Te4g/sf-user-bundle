{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'account.delete_page_title'|trans({'%app_name%': app_name}) }}{% endblock %}

{% block main %}
<main class="mx-auto w-full max-w-2xl px-4 py-10 sm:px-6">
    <twig:Card>
        <twig:Card:Header>
            <twig:Card:Title><h1 class="text-xl text-destructive">{{ 'account.delete_title'|trans }}</h1></twig:Card:Title>
            <twig:Card:Description>{{ 'account.delete_description'|trans({'%email%': account.email}) }}</twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Content>
            <twig:AlertDialog id="delete-account">
                {{ form_start(form, {attr: {class: 'space-y-5', 'data-alert-dialog-target': 'form'}}) }}
                    {% if form.vars.submitted and not form.vars.valid %}
                        <twig:Alert variant="destructive">
                            <twig:ux:icon name="lucide:triangle-alert" />
                            <twig:Alert:Title>{{ 'form.error_summary'|trans }}</twig:Alert:Title>
                            <twig:Alert:Description>{{ form_errors(form) }}</twig:Alert:Description>
                        </twig:Alert>
                    {% endif %}
                    <twig:Field data-controller="password-visibility" data-password-visibility-show-label-value="{{ 'password.show'|trans }}" data-password-visibility-hide-label-value="{{ 'password.hide'|trans }}">
                        <twig:Field:Label for="{{ form.currentPassword.vars.id }}" class="{{ form.currentPassword.vars.required ? 'required' : '' }}">{{ form.currentPassword.vars.label|trans(form.currentPassword.vars.label_translation_parameters, form.currentPassword.vars.translation_domain) }}</twig:Field:Label>
                        <div class="relative">
                            {{ form_widget(form.currentPassword, {attr: {'aria-describedby': form.currentPassword.vars.id ~ '_errors', 'data-password-visibility-target': 'input', class: 'pr-28'}}) }}
                            <twig:Button type="button" variant="ghost" size="sm" class="absolute right-1 top-1" aria-pressed="false" data-password-visibility-target="button" data-action="click->password-visibility#toggle"><twig:ux:icon name="lucide:eye" /><span data-password-visibility-target="label">{{ 'password.show'|trans }}</span></twig:Button>
                        </div>
                        {{ form_errors(form.currentPassword) }}
                    </twig:Field>
                    <twig:Field orientation="horizontal">
                        <div>{{ form_widget(form.confirm, {attr: {'aria-describedby': form.confirm.vars.id ~ '_errors'}}) }}</div>
                        <twig:Field:Content>
                            <twig:Field:Label for="{{ form.confirm.vars.id }}" class="{{ form.confirm.vars.required ? 'required' : '' }}">{{ form.confirm.vars.label|trans(form.confirm.vars.label_translation_parameters, form.confirm.vars.translation_domain) }}</twig:Field:Label>
                            {{ form_errors(form.confirm) }}
                        </twig:Field:Content>
                    </twig:Field>
                    {{ form_widget(form._token) }}
                    <div class="flex flex-wrap gap-3">
                        <twig:AlertDialog:Trigger><twig:Button type="button" variant="destructive" {{ ...alert_dialog_trigger_attrs }}><twig:ux:icon name="lucide:trash-2" />{{ 'account.delete_submit'|trans }}</twig:Button></twig:AlertDialog:Trigger>
                        <twig:Button as="a" href="{{ path('app_account') }}" variant="ghost">{{ 'common.cancel'|trans }}</twig:Button>
                    </div>
                    <twig:AlertDialog:Content>
                        <twig:AlertDialog:Header>
                            <twig:AlertDialog:Media class="bg-destructive/10 text-destructive"><twig:ux:icon name="lucide:triangle-alert" /></twig:AlertDialog:Media>
                            <twig:AlertDialog:Title>{{ 'account.delete_confirm_title'|trans }}</twig:AlertDialog:Title>
                            <twig:AlertDialog:Description>{{ 'account.delete_confirm_copy'|trans }}</twig:AlertDialog:Description>
                        </twig:AlertDialog:Header>
                        <twig:AlertDialog:Footer>
                            <twig:AlertDialog:Cancel type="button">{{ 'account.delete_cancel'|trans }}</twig:AlertDialog:Cancel>
                            <twig:AlertDialog:Action type="button" variant="destructive" data-action="click->alert-dialog#submit">{{ 'account.delete_submit'|trans }}</twig:AlertDialog:Action>
                        </twig:AlertDialog:Footer>
                    </twig:AlertDialog:Content>
                {{ form_end(form, {render_rest: false}) }}
            </twig:AlertDialog>
        </twig:Card:Content>
    </twig:Card>
</main>
{% endblock %}
