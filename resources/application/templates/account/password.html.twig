{% extends 'layout/app.html.twig' %}
{% block title %}{{ 'password_change.title'|trans }}{% endblock %}
{% block main %}
<main class="mx-auto w-full max-w-2xl px-4 py-12"><twig:Card>
<twig:Card:Header><twig:Card:Title><h1 class="flex items-center gap-2 text-xl"><twig:ux:icon name="lucide:eye-off" />{{ 'password_change.title'|trans }}</h1></twig:Card:Title></twig:Card:Header><twig:Card:Content>
{{ form_start(form, {attr: {class: 'space-y-5'}}) }}{% if form.vars.submitted and not form.vars.valid %}<twig:Alert variant="destructive"><twig:Alert:Title>{{ 'form.error_summary'|trans }}</twig:Alert:Title><twig:Alert:Description>{{ form_errors(form) }}</twig:Alert:Description></twig:Alert>{% endif %}
<twig:Field><twig:Field:Label for="{{ form.currentPassword.vars.id }}" class="{{ form.currentPassword.vars.required ? 'required' : '' }}">{{ form.currentPassword.vars.label|trans(form.currentPassword.vars.label_translation_parameters, form.currentPassword.vars.translation_domain) }}</twig:Field:Label>{{ form_widget(form.currentPassword, {attr: {'aria-describedby': form.currentPassword.vars.id ~ '_errors'}}) }}{{ form_errors(form.currentPassword) }}</twig:Field>
<twig:Field data-controller="password-visibility" data-password-visibility-show-label-value="{{ 'password.show'|trans }}" data-password-visibility-hide-label-value="{{ 'password.hide'|trans }}"><twig:Field:Label for="{{ form.plainPassword.first.vars.id }}" class="{{ form.plainPassword.first.vars.required ? 'required' : '' }}">{{ form.plainPassword.first.vars.label|trans(form.plainPassword.first.vars.label_translation_parameters, form.plainPassword.first.vars.translation_domain) }}</twig:Field:Label><div class="relative">{{ form_widget(form.plainPassword.first, {attr: {'aria-describedby': form.plainPassword.first.vars.id ~ '_errors', 'data-password-visibility-target': 'input', class: 'pr-28'}}) }}<twig:Button type="button" variant="ghost" size="sm" class="absolute right-1 top-1" aria-pressed="false" data-password-visibility-target="button" data-action="click->password-visibility#toggle"><twig:ux:icon name="lucide:eye" /><span data-password-visibility-target="label">{{ 'password.show'|trans }}</span></twig:Button></div>{{ form_errors(form.plainPassword.first) }}</twig:Field>
<twig:Field><twig:Field:Label for="{{ form.plainPassword.second.vars.id }}" class="{{ form.plainPassword.second.vars.required ? 'required' : '' }}">{{ form.plainPassword.second.vars.label|trans(form.plainPassword.second.vars.label_translation_parameters, form.plainPassword.second.vars.translation_domain) }}</twig:Field:Label>{{ form_widget(form.plainPassword.second, {attr: {'aria-describedby': form.plainPassword.vars.id ~ '_errors ' ~ form.plainPassword.second.vars.id ~ '_errors'}}) }}{{ form_errors(form.plainPassword) }}{{ form_errors(form.plainPassword.second) }}</twig:Field>
{{ form_rest(form) }}<twig:Button type="submit" data-turbo-submits-with="{{ 'form.submitting'|trans }}"><twig:Spinner class="hidden" label="{{ 'form.submitting'|trans }}" />{{ 'password_change.submit'|trans }}</twig:Button>{{ form_end(form, {render_rest: false}) }}
</twig:Card:Content></twig:Card></main>
{% endblock %}
