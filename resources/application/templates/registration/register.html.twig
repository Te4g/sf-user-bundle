{% extends 'layout/auth.html.twig' %}
{% block title %}{{ 'registration.title'|trans }}{% endblock %}
{% block main %}
<main class="mx-auto flex min-h-[calc(100svh-4rem)] w-full max-w-md items-center px-4 py-10">
    <twig:Card class="w-full shadow-sm">
        <twig:Card:Header>
            <twig:Card:Title><h1 class="text-xl">{{ 'registration.title'|trans }}</h1></twig:Card:Title>
            <twig:Card:Description>{{ 'registration.status'|trans }}</twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Content>
            <div class="sr-only" aria-live="polite">{{ 'registration.status'|trans }}</div>
            {% if form.vars.submitted and not form.vars.valid %}
                <twig:Alert variant="destructive" class="mb-5"><twig:ux:icon name="lucide:triangle-alert" /><twig:Alert:Title>{{ 'form.error_summary'|trans }}</twig:Alert:Title><twig:Alert:Description>{{ form_errors(form) }}</twig:Alert:Description></twig:Alert>
            {% endif %}
            {{ form_start(form, {attr: {class: 'space-y-5'}}) }}
                <twig:Field>
                    <twig:Field:Label for="{{ form.email.vars.id }}" class="{{ form.email.vars.required ? 'required' : '' }}">{{ form.email.vars.label|trans(form.email.vars.label_translation_parameters, form.email.vars.translation_domain) }}</twig:Field:Label>
                    {{ form_widget(form.email, {attr: {'aria-describedby': 'registration-email-help registration_email_errors'}}) }}
                    <twig:Field:Description id="registration-email-help">{{ 'registration.status'|trans }}</twig:Field:Description>
                    {{ form_errors(form.email) }}
                </twig:Field>
                <twig:Field data-controller="password-visibility" data-password-visibility-show-label-value="{{ 'password.show'|trans }}" data-password-visibility-hide-label-value="{{ 'password.hide'|trans }}">
                    <twig:Field:Label for="{{ form.plainPassword.first.vars.id }}" class="{{ form.plainPassword.first.vars.required ? 'required' : '' }}">{{ form.plainPassword.first.vars.label|trans(form.plainPassword.first.vars.label_translation_parameters, form.plainPassword.first.vars.translation_domain) }}</twig:Field:Label>
                    <div class="relative">
                        {{ form_widget(form.plainPassword.first, {attr: {'aria-describedby': 'registration_plainPassword_first_errors', 'data-password-visibility-target': 'input', class: 'pr-28'}}) }}
                        <twig:Button type="button" variant="ghost" size="sm" class="absolute right-1 top-1" aria-pressed="false" data-password-visibility-target="button" data-action="click->password-visibility#toggle"><twig:ux:icon name="lucide:eye" /><span data-password-visibility-target="label">{{ 'password.show'|trans }}</span></twig:Button>
                    </div>
                    {{ form_errors(form.plainPassword.first) }}
                </twig:Field>
                <twig:Field>
                    <twig:Field:Label for="{{ form.plainPassword.second.vars.id }}" class="{{ form.plainPassword.second.vars.required ? 'required' : '' }}">{{ form.plainPassword.second.vars.label|trans(form.plainPassword.second.vars.label_translation_parameters, form.plainPassword.second.vars.translation_domain) }}</twig:Field:Label>
                    {{ form_widget(form.plainPassword.second, {attr: {'aria-describedby': 'registration_plainPassword_errors registration_plainPassword_second_errors'}}) }}
                    {{ form_errors(form.plainPassword) }}{{ form_errors(form.plainPassword.second) }}
                </twig:Field>
                {{ form_rest(form) }}
                <twig:Button type="submit" class="w-full" data-turbo-submits-with="{{ 'form.submitting'|trans }}"><twig:Spinner class="hidden" label="{{ 'form.submitting'|trans }}" />{{ 'registration.submit'|trans }}</twig:Button>
            {{ form_end(form, {render_rest: false}) }}
        </twig:Card:Content>
    </twig:Card>
</main>
{% endblock %}
