{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans({'%app_name%': app_name}) }}{% endblock %}

{% block main %}
<main class="mx-auto w-full max-w-6xl space-y-8 px-4 py-10 sm:px-6 lg:px-8">
    <header class="space-y-2">
        <h1 class="text-3xl font-semibold tracking-tight">{{ 'dashboard.heading'|trans }}</h1>
        <p class="max-w-2xl text-sm leading-6 text-muted-foreground">{{ 'dashboard.copy'|trans }}</p>
    </header>

    <twig:Card>
        <twig:Card:Header>
            <twig:Card:Title><h2>{{ 'dashboard.empty_title'|trans }}</h2></twig:Card:Title>
            <twig:Card:Description>{{ 'dashboard.empty_copy'|trans }}</twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Footer>
            <twig:Button as="a" href="{{ path('app_account') }}" variant="outline">{{ 'dashboard.account_action'|trans }}</twig:Button>
        </twig:Card:Footer>
    </twig:Card>
</main>
{% endblock %}
