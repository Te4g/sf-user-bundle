<!doctype html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}" data-turbo-track="reload">
    {{ importmap('app') }}
</head>
<body class="min-h-screen bg-background text-foreground">
    <div id="flash-messages" class="fixed inset-x-0 top-4 z-50 mx-auto w-[min(32rem,calc(100%-2rem))] space-y-2" aria-live="polite" aria-atomic="true">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <twig:Alert variant="{{ type in ['error', 'danger'] ? 'destructive' : 'default' }}">
                    <twig:Alert:Description>{{ message|trans }}</twig:Alert:Description>
                </twig:Alert>
            {% endfor %}
        {% endfor %}
    </div>
    {% block body %}{% endblock %}
</body>
</html>
